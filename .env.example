# "demo" mantiene los datos ficticios. Cambia a "supabase" únicamente en un entorno de pruebas configurado.
NEXT_PUBLIC_APP_MODE=demo
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Datos publicables del proyecto Supabase de pruebas. Nunca incluir service_role aquí.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
