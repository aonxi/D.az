# "demo" mantiene los datos ficticios. Cambia a "supabase" únicamente en un entorno de pruebas configurado.
NEXT_PUBLIC_APP_MODE=demo
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Datos publicables del proyecto Supabase de pruebas. Nunca incluir service_role aquí.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Variables privadas del servidor. No deben comenzar con NEXT_PUBLIC_ ni copiarse al navegador.
# Usa una Secret key nueva de Supabase; no una clave escrita dentro del repositorio.
SUPABASE_SECRET_KEY=
# Genera un valor aleatorio largo y diferente para staging y producción.
PUBLIC_FORM_RATE_LIMIT_SECRET=

# Defensa escalonada del formulario público. Valores iniciales conservadores para una red móvil compartida.
PUBLIC_FORM_IP_LIMIT=12
PUBLIC_FORM_GLOBAL_LIMIT=300
PUBLIC_FORM_RATE_WINDOW_MINUTES=60
